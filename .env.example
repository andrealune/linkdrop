# PostgreSQL connection string used by the server
DATABASE_URL=postgres://postgres:postgres@localhost:5432/linkdrop

# Port the Express server listens on
PORT=3001

# Admin token required in the Authorization header for
# DELETE /api/links/:id and POST /api/links/:id/tags
LINKDROP_ADMIN_TOKEN=change-me

# Base URL the web client uses to reach the API (consumed by web/.env)
VITE_API_URL=http://localhost:3001
